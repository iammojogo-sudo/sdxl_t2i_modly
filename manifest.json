{
  "id": "sdxl_t2i",
  "name": "SDXL Text-to-Image",
  "type": "model",
  "source": "https://github.com/iammojogo-sudo/sdxl_t2i_modly",
  "description": "Text-to-image using Stable Diffusion XL. High quality, works on 6GB+ with CPU offloading.",
  "version": "1.0.0",
  "author": "iammojogo",
  "vram_gb": 6,
  "tags": [
    "text-to-image",
    "sdxl",
    "stable-diffusion"
  ],
  "nodes": [
    {
      "id": "generate",
      "name": "Generate Image",
      "output": "image",
      "hf_repo": "stabilityai/stable-diffusion-xl-base-1.0",
      "download_check": "model_index.json",
      "params_schema": [
        {
          "id": "prompt",
          "label": "Prompt",
          "type": "string",
          "default": "",
          "multiline": true,
          "tooltip": "Describe the image you want to generate."
        },
        {
          "id": "negative_prompt",
          "label": "Negative Prompt",
          "type": "string",
          "default": "",
          "tooltip": "Describe what you do NOT want in the image."
        },
        {
          "id": "width",
          "label": "Width",
          "type": "int",
          "default": 1024,
          "min": 512,
          "max": 1280
        },
        {
          "id": "height",
          "label": "Height",
          "type": "int",
          "default": 1024,
          "min": 512,
          "max": 1280
        },
        {
          "id": "steps",
          "label": "Steps",
          "type": "int",
          "default": 30,
          "min": 10,
          "max": 50
        },
        {
          "id": "guidance_scale",
          "label": "Guidance Scale",
          "type": "float",
          "default": 7,
          "min": 1,
          "max": 15
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": 0,
          "min": 0,
          "max": 4294967295
        }
      ]
    }
  ],
  "generator_class": "SDXLGenerator"
}
